# Copy to .env (same folder) and fill in. Never commit .env.

# --- Databricks (SQL Warehouses → your warehouse → Connection details)
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_WAREHOUSE_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
# Settings → Developer → Access tokens → Generate new token
# (or omit and set DATABRICKS_CLIENT_ID / DATABRICKS_CLIENT_SECRET for SDK auth)
DATABRICKS_TOKEN=
CATALOG=river
# Serving → the pay-per-token endpoint you used in gold_build.sql (llm_model)
LLM_MODEL=databricks-meta-llama-3-3-70b-instruct
# Gate confidence needed to auto-resolve without the LLM (round R2 value)
AUTO_RESOLVE_THRESHOLD=0.85

# --- Phone call (optional; the app simulates the call when these are missing)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# First contact, and optional escalation contact if the first doesn't answer (E.164)
CONTACT_1=+1XXXXXXXXXX
CONTACT_2=
ELEVENLABS_API_KEY=
# python page.py --setup lists your agent and phone-number ids
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
RING_TIMEOUT_S=30
